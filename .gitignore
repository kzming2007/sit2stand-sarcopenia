# 독점 바이너리이므로 재배포하지 않는다. 재구성 방법은 README 참조.
k4abt_sdk/

# 선행 연구(Boswell et al. 2023) 공개 저장소 + 피험자 궤적 (300MB).
# 원 저장소가 이미 공개돼 있으므로 링크로 대체한다.
sit2stand-analysis-main/

# MediaPipe 모델 (9.4MB). 재배포 대신 아래 명령으로 받는다.
#   python scripts/mediapipe_pose.py --download-model
models/

# ── 산출물 / 로컬 ──────────────────────────────────────────
scratch/
*.mkv
*.npy
__pycache__/
*.pyc
.claude/settings.local.json

# ── 개인정보 ───────────────────────────────────────────────
